load("@rules_webpack//webpack:defs.bzl", "webpack_bundle")

package(default_visibility = ["//visibility:public"])

webpack_bundle(
    name = "bundle",
    entry_point = "index.js",
    node_modules = "@@//:node_modules",
)

webpack_bundle(
    name = "bundle_config",
    entry_point = "index.js",
    node_modules = "@@//:node_modules",
    webpack_config = "@@//:webpack_config",
)

webpack_bundle(
    name = "bundle_worker",
    entry_point = "index.js",
    node_modules = "@@//:node_modules",
    supports_workers = True,
)
